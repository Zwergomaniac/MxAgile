{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Canonical schema for the Artifact Trace Index, representing the single source of truth for the structure of the consolidated index.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "A stable, path-based identifier for the artifact."
          },
          "type": {
            "type": "string",
            "enum": ["Mockup", "Requirement", "FeatureSpec", "Plan", "Task", "MendixArtifact", "PageYAML"],
            "description": "The type of the artifact."
          },
          "hash": {
            "type": "string",
            "description": "SHA256 hash of the artifact's content."
          },
          "status": {
            "type": "string",
            "enum": ["Active", "Stale"],
            "description": "The status of the artifact."
          }
        },
        "required": ["id", "type", "hash", "status"]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "The ID of the source node."
          },
          "to": {
            "type": "string",
            "description": "The ID of the target node."
          },
          "provenance": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["DECLARED", "DERIVED", "INFERRED"],
                "description": "The type of relationship."
              },
              "source": {
                "type": "string",
                "description": "The file path where the relationship was found."
              }
            },
            "required": ["type", "source"]
          }
        },
        "required": ["from", "to", "provenance"]
      }
    }
  },
  "required": ["nodes", "edges"]
}
