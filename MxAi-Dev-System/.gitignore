# Common Mendix local state
/.mendix-cache/
/deployment/
/packages/
/project-settings.user.json
*.mpr.lock
*.mpr.bak


# mxcli working directory: machine-local constant values (may contain
# secrets), the run/test handshake, and runtime logs. Never commit these.
.mxcli/

# Temporary testing instance directory
.testing-MxAi/
.testing*/
 
# Mendix project template directory (not part of the framework) 
# project-templates/
# !project-templates/greenfield

# Company-specific layers (prototypes)
# company-layers/


# Runtime State, Installed Artifacts, and Generated Files

# Installed Company Layers (should not be tracked)
/.mxagile/layers/

# Generated trace indexes and other state
/.mxagile/state/

# Temporary directory for layer fetching
/.mxagile/tmp_layer/

# Runtime test logs
/tests/*.log

# Temporary test workspaces
/tests/temp-project/
/tests/mock-mendix-project/

# The mxcli binary is a downloaded tool, not source
/mxcli.exe

# Temporary error logs
/err.txt

# Concord runtime state
/.concord/

