{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mxagile:experimental-control-plane-verdict",
  "title": "Experimental MxAgile Control-Plane Gate Verdict",
  "description": "Transient evaluator output (Phase 1). Never persisted in consumer projects and never lifecycle authority. A future persisted form must bump schema_version and ship through install-core plus a Doctor compatibility projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate_id", "gate_type", "verdict", "run_id", "mission_id", "wave_id", "producer",
    "input_references", "evidence_references", "must_findings", "should_findings", "scope",
    "checked_roles", "checked_states", "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "gate_id": { "type": "string", "minLength": 1 },
    "gate_type": { "type": "string", "enum": ["transition", "mutation", "delegation", "visual_verification"] },
    "verdict": { "type": "string", "enum": ["pass", "fail", "needs_human", "partial", "unavailable"] },
    "run_id": { "type": ["string", "null"] },
    "mission_id": { "type": ["string", "null"] },
    "wave_id": { "type": ["string", "null"] },
    "producer": { "type": "string", "minLength": 1 },
    "input_references": { "type": "array", "items": { "$ref": "#/definitions/reference" } },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "recovery_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_next_action", "allowed_recovery_actions", "blocked_recovery_actions", "reason_codes", "decision_references"],
      "properties": {
        "primary_next_action": {"type": ["string", "null"], "enum": ["inspect", "resume", "resume_projection", "retry_safe_step", "rollback", "human_resolution", "resync", "doctor", null]},
        "allowed_recovery_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["inspect", "resume", "resume_projection", "retry_safe_step", "rollback", "human_resolution", "resync", "doctor"]}},
        "blocked_recovery_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["inspect", "resume", "resume_projection", "retry_safe_step", "rollback", "human_resolution", "resync", "doctor"]}},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "decision_references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {
          "diagnostic_id": {"type": "string"}, "source_path": {"type": "string"}, "authority": {"type": "string"}, "category": {"type": "string"}
        }}}
      }
    },
    "must_findings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "should_findings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "paths"],
      "properties": {
        "summary": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checked_roles": { "type": "array", "items": { "type": "string" } },
    "checked_states": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "round": { "type": "integer", "minimum": 1 },
    "visual": { "$ref": "#/definitions/visual" },
    "event": {
      "type": "object",
      "description": "Audit candidate only; never canonical lifecycle state.",
      "additionalProperties": false,
      "required": ["type", "run_id"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
        "run_id": { "type": ["string", "null"] },
        "parent_run_id": { "type": ["string", "null"] }
      }
    }
  },
  "definitions": {
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mockup_revision", "page", "route", "roles", "states", "requirements", "decisions", "verification_mode", "evidence", "input_fingerprint"],
      "properties": {
        "mockup_revision": { "type": "string", "minLength": 1 },
        "page": { "type": "string", "minLength": 1 },
        "html_first_source": { "type": ["string", "null"] },
        "route": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "states": { "type": "array", "items": { "type": "string" } },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "verification_mode": { "type": "string", "enum": ["static", "runtime"] },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "state", "kind", "layer", "path", "sha256"],
            "properties": {
              "role": { "type": "string" },
              "state": { "type": "string" },
              "kind": { "type": "string", "enum": ["screenshot", "trace", "dom_snapshot", "manifest"] },
              "layer": { "type": "string", "enum": ["static", "runtime"] },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "input_fingerprint": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "reference": {
      "type": "object",
      "required": ["kind", "reference", "sha256"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["code", "summary", "disposition"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "summary": { "type": "string", "minLength": 1 },
        "disposition": { "type": "string", "enum": ["fail", "needs_human", "unavailable", "advisory"] },
        "reference": { "type": "string" },
        "recovery": {
          "type": "string",
          "enum": ["inspect", "resume", "resume_projection", "retry_safe_step", "rollback", "human_resolution", "resync", "doctor"]
        }
      }
    }
  }
}
