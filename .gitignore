# Credentials — only .example files are templates
.env.mendix
.mcp.json

# Build / runtime output from test runs
deployment/
docker-check-result.txt
*.log

# mxcli runtime cache
.mxcli/

# Runtime state (generated by mxcli/indexer — not source-controlled)
.mxagile/state/

# Graphify enrichment output (generated — rebuild with: graphify update <path>)
# Anchored to repo root only; test fixture graphify-out/ is committed as test data
/graphify-out/

# Python bytecode cache
__pycache__/
*.pyc

# Generated platform projections (produced by generate-mxagile-platform-skills.ps1)
# Checked in if you want snapshot history; ignored here to keep repo clean for framework dev
.agents/
.claude/skills/
.github/
.grok/
.hermes/
.opencode/

# Test fixture projects created by regression suite
.testing-*/
project-templates/brownfield_migration_captrack/

# IDE user files
.vs/
*.user
*.suo

# OS metadata
Thumbs.db
desktop.ini

# Editor / tool backups
*.bak
*.tmp

# Nested working repo (framework development)
MxAi-Dev-System/
.claude/worktrees/*
