# Credentials — only .example files are templates
.env.mendix
.mcp.json

# Build / runtime output from test runs
deployment/
docker-check-result.txt
*.log

# mxcli runtime cache
.mxcli/

# Context Lifecycle operational store (gitignored durable local session state).
# Explicit handoff artifacts go to planning/lifecycle/ (git-tracked, committed intentionally).
.concord/

# Runtime state (generated by mxcli/indexer — not source-controlled)
.mxagile/state/

# Context Mode state normally lives under the user profile. These are ephemeral if redirected into a workspace.
.context-mode/
.github/context-mode/

# Graphify enrichment output (generated — rebuild with: graphify update <path>)
# Anchored to repo root only; test fixture graphify-out/ is committed as test data
/graphify-out/

# Python bytecode cache
__pycache__/
*.pyc

# Generated platform projections (produced by generate-mxagile-platform-skills.ps1)
# Checked in if you want snapshot history; ignored here to keep repo clean for framework dev
# NOTE: Only ignore the generated subdirectories, not entire parent dirs — external skills
# in the same parent directories are source-controlled and must remain trackable.
.agents/skills/mxagile/
.agents/skills/dfc/
.claude/skills/mxagile-*/
.claude/agents/mxagile-*.md
.github/
.grok/
.hermes/
.opencode/

# Test fixture projects created by regression suite
.testing-*/
project-templates/brownfield_migration_demo/

# IDE user files
.vs/
*.user
*.suo

# OS metadata
Thumbs.db
desktop.ini

# Editor / tool backups
*.bak
*.tmp

# Nested working repo (framework development)
MxAi-Dev-System/
.claude/worktrees/*

# Local reference implementations
.reference/
