{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mx-project/planning/story-spec.schema.json",
  "title": "Mendix Project Story Specification",
  "description": "Schema for story specs under planning/stories/. Also used as output schema for mockup-to-spec extraction agents.",
  "type": "object",
  "required": ["module", "title", "domain", "sprint_target", "priority", "status", "overview", "user_stories"],
  "additionalProperties": false,

  "properties": {

    "module": {
      "type": "string",
      "description": "Domain prefix + number, e.g. C4, D7, INFRA-auth",
      "pattern": "^([A-Z]\\d+|INFRA-[a-z-]+)$"
    },

    "title": {
      "type": "string",
      "description": "Human-readable spec title"
    },

    "domain": {
      "type": "string",
      "description": "e.g. C — Anwesenheit & Tagesbetrieb"
    },

    "sprint_target": {
      "type": "string",
      "description": "e.g. Sprint 2 (Tagesbetrieb)"
    },

    "priority": {
      "type": "string",
      "enum": ["Must", "Should", "Could"]
    },

    "subscription_tier": {
      "type": "string",
      "description": "Feature-Gating tier (optional, project-specific)"
    },

    "decisions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^D\\d+$" },
      "description": "Referenced architecture decisions, e.g. [D7, D30]"
    },

    "status": {
      "type": "string",
      "enum": ["Draft", "Review required", "Current", "Blocked", "Superseded"]
    },

    "board_story": {
      "type": "string",
      "description": "Backlog board story ID, e.g. {STORYPREFIX}-123 (optional if not yet synced)"
    },

    "source_fingerprint": {
      "type": "string",
      "description": "Hash from board snapshot for reconciliation"
    },

    "overview": {
      "type": "string",
      "description": "Short prose: business context, feature-gating, cross-cutting notes"
    },

    "user_stories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/UserStory" }
    },

    "cross_cutting": {
      "$ref": "#/definitions/CrossCutting"
    },

    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/definitions/Dependency" }
    },

    "mockup_relevance": {
      "type": "object",
      "properties": {
        "present": { "type": "boolean" },
        "flows_to_verify": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Flows/interactions to verify in the mockup before implementation"
        },
        "screens": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Mockup screen IDs, e.g. F05, E03"
        }
      }
    },

    "design_contract_provenance": {
      "type": "object",
      "description": "Provenance record for an imported Mocketeer Design Contract. Created by the Discovery Agent during Design Contract intake. See policies/design-contract-intake.md.",
      "properties": {
        "source_system": {
          "type": "string",
          "enum": ["mocketeer"],
          "description": "Source system that produced the Design Contract."
        },
        "source_artifact": {
          "type": "string",
          "description": "Design Contract identifier (mockup.id). Part of source identity."
        },
        "mockup_id": {
          "type": "string",
          "description": "Backward-compatible alias for source_artifact."
        },
        "source_revision": {
          "type": ["string", "integer"],
          "description": "Design Contract revision (mockup.revision). Part of source identity."
        },
        "revision": {
          "type": ["string", "integer"],
          "description": "Backward-compatible alias for source_revision."
        },
        "intake_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "ISO date when intake was performed."
        },
        "intake_result": {
          "type": "string",
          "enum": ["COMPLETE", "PARTIAL", "FAILED", "TRACEABILITY_ERROR", "INTAKE_FAILED", "INTAKE_PARTIAL"],
          "description": "Outcome of the intake. TRACEABILITY_ERROR blocks Refinement."
        },
        "partial_reason": {
          "type": "string",
          "description": "Reason when intake_result is PARTIAL or TRACEABILITY_ERROR."
        },
        "maturity_assessed": {
          "type": "boolean",
          "description": "True when a Mocketeer assessment block was consumed."
        },
        "prototype_readiness": {
          "type": "string",
          "description": "Upstream prototype readiness value from assessment block."
        },
        "development_handoff_readiness": {
          "type": "string",
          "description": "Upstream handoff readiness value from assessment block."
        },
        "blocking_gaps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Gap IDs that block handoff, from assessment block."
        },
        "id_map": {
          "type": "array",
          "description": "Source-to-canonical ID mapping table. Discovery populates source side (PENDING/COLLISION). Refinement completes canonical side (DIRECT/MAPPED/EXCLUDED). See policies/design-contract-intake.md — SOURCE-TO-CANONICAL MAPPING.",
          "items": { "$ref": "#/definitions/IdMapEntry" }
        }
      }
    }
  },

  "definitions": {

    "UserStory": {
      "type": "object",
      "required": ["id", "role", "priority", "complexity", "description", "acceptance_criteria"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "e.g. US-C4-001",
          "pattern": "^US-[A-Z0-9]+-\\d{3}$"
        },
        "role": {
          "type": "string",
          "description": "Primary Mendix user role"
        },
        "secondary_roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority": {
          "type": "string",
          "enum": ["Must", "Should", "Could"]
        },
        "complexity": {
          "type": "string",
          "enum": ["Low", "Medium", "High"]
        },
        "description": {
          "type": "string",
          "description": "As [role] I want [action] so that [outcome]"
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "entities": {
          "type": "array",
          "items": { "$ref": "#/definitions/Entity" }
        },
        "associations": {
          "type": "array",
          "items": { "$ref": "#/definitions/Association" }
        },
        "enumerations": {
          "type": "array",
          "items": { "$ref": "#/definitions/Enumeration" }
        },
        "pages": {
          "type": "array",
          "items": { "$ref": "#/definitions/Page" }
        },
        "microflows": {
          "type": "array",
          "items": { "$ref": "#/definitions/Microflow" }
        },
        "business_rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ux_hints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "question"],
            "properties": {
              "type": { "type": "string", "enum": ["DECISION REQUIRED", "ASSUMPTION"] },
              "question": { "type": "string" },
              "recommendation": { "type": "string" },
              "blocks_implementation": { "type": "boolean" }
            }
          }
        }
      }
    },

    "Entity": {
      "type": "object",
      "required": ["name", "persistence", "attributes"],
      "properties": {
        "name": { "type": "string", "description": "PascalCase, e.g. OrderItem" },
        "persistence": { "type": "string", "enum": ["Persistent", "NonPersistent"] },
        "extends": { "type": "string", "description": "Generalization, e.g. System.Image" },
        "documentation": { "type": "string" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/Attribute" }
        }
      }
    },

    "Attribute": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["String", "Integer", "Long", "Decimal", "Boolean", "DateTime", "Date", "AutoNumber", "Enum", "Binary", "LongString"]
        },
        "length": { "type": "integer", "description": "For String types" },
        "enum_ref": { "type": "string", "description": "Enum name if type is Enum" },
        "required": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "default": {},
        "documentation": { "type": "string" }
      }
    },

    "Association": {
      "type": "object",
      "required": ["name", "from", "to", "type"],
      "properties": {
        "name": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string", "enum": ["OneToMany", "ManyToMany", "OneToOne"] },
        "owner": { "type": "string", "enum": ["from", "to", "both"] }
      }
    },

    "Enumeration": {
      "type": "object",
      "required": ["name", "values"],
      "properties": {
        "name": { "type": "string", "description": "e.g. ENUM_OrderStatus" },
        "values": { "type": "array", "items": { "type": "string" } }
      }
    },

    "Page": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "e.g. Order_Overview" },
        "description": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } }
      }
    },

    "Microflow": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "e.g. ACT_Order_Create" },
        "description": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["ACT", "SUB", "VAL", "DS", "SE", "NAV"],
          "description": "ACT=action, SUB=sub, VAL=validation, DS=datasource, SE=scheduled, NAV=navigation"
        }
      }
    },

    "CrossCutting": {
      "type": "object",
      "properties": {
        "tenant_isolation": { "type": "string", "description": "XPath constraint pattern" },
        "audit": { "type": "string" },
        "privacy": { "type": "string" },
        "security": { "type": "string" }
      }
    },

    "Dependency": {
      "type": "object",
      "required": ["entity_or_module", "module", "description"],
      "properties": {
        "entity_or_module": { "type": "string" },
        "module": { "type": "string" },
        "description": { "type": "string" }
      }
    },

    "IdMapEntry": {
      "type": "object",
      "description": "One entry in the source-to-canonical mapping table. Discovery sets source_type, source_id, mapping_status PENDING or COLLISION. Refinement completes canonical_id and updates mapping_status.",
      "required": ["source_type", "source_id", "canonical_id", "mapping_status"],
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["requirement", "decision", "business_rule", "role", "screen", "flow", "gap"],
          "description": "The artifact type as classified in the Design Contract."
        },
        "source_id": {
          "type": "string",
          "description": "The element ID as expressed in the Design Contract (e.g. REQ-066, DEC-024)."
        },
        "source_revision": {
          "type": ["string", "integer", "null"],
          "description": "Design Contract revision this element came from. Part of full source identity."
        },
        "source_status": {
          "type": "string",
          "description": "The Design Contract status of this element (e.g. CONFIRMED_BY_STAKEHOLDER)."
        },
        "canonical_type": {
          "type": ["string", "null"],
          "enum": ["requirement", "decision", "business_rule", "role", "screen", "flow", null],
          "description": "The MxAgile canonical artifact type. Null when no canonical equivalent exists (e.g. ROLE entries without a canonical role artifact)."
        },
        "canonical_id": {
          "type": ["string", "null"],
          "description": "The canonical artifact ID (e.g. REQ-068, DEC-031). Null when mapping_status is PENDING or COLLISION — Refinement populates this field."
        },
        "mapping_status": {
          "type": "string",
          "enum": ["PENDING", "DIRECT", "MAPPED", "EXCLUDED", "COLLISION"],
          "description": "PENDING: Discovery complete, canonical side not yet resolved. DIRECT: Same semantic content confirmed (IDs may differ). MAPPED: Canonical ID allocated (different from source). EXCLUDED: Explicitly excluded with justification. COLLISION: Source ID matches an unrelated canonical artifact."
        },
        "collision_note": {
          "type": "string",
          "description": "Explanation when mapping_status is COLLISION. States why the source ID and the existing canonical ID are unrelated."
        },
        "exclusion_reason": {
          "type": "string",
          "description": "Justification when mapping_status is EXCLUDED."
        },
        "source_superseded_by": {
          "type": "string",
          "description": "Source-level supersession: the source_id that supersedes this element within the Design Contract. Preserved as-is; resolved to canonical in a separate canonical relationship field."
        },
        "source_governs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Source-level governance: source_ids governed by this decision within the Design Contract."
        }
      }
    }
  }
}
