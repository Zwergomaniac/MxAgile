{
  "servers": {
    "concord-v2-mcp": {
      "type": "stdio",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/start-concord-mcp.ps1"
      ]
    },
    "mendix-studio-pro": {
      "type": "http",
      "url": "http://localhost:7782/mcp"
    }
  }
}
