{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MxAgile Task",
  "description": "Canonical concrete actionable implementation task. Canonical location: planning/tasks/TASK-NNN.yml. Primary key: ID. Consumed by build_artifact_index.py for IMPLEMENTED_BY edges (spec field).",
  "type": "object",
  "required": ["ID", "spec", "action"],
  "additionalProperties": false,
  "properties": {
    "ID": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$",
      "description": "Stable unique identifier. Primary key in the artifact index. Must match filename stem (TASK-001.yml -> ID: TASK-001)."
    },
    "spec": {
      "type": "string",
      "pattern": "^SPEC-",
      "description": "Parent spec ID. Creates an IMPLEMENTED_BY edge in the artifact index: Spec -> Task. Required for full traceability."
    },
    "req": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-"
      },
      "description": "Optional direct requirement references for supplementary traceability when a task addresses a requirement more directly than the spec relationship implies."
    },
    "type": {
      "type": "string",
      "enum": ["entity", "module", "microflow", "nanoflow", "page", "security", "navigation", "integration", "repair", "other"],
      "description": "Primary Mendix artifact category this task creates or modifies. Use 'repair' for GAP Verification & Repair tasks (type: repair)."
    },
    "action": {
      "type": "string",
      "description": "Short description of what this task does. Used as display name in the artifact index. One line."
    },
    "detail": {
      "type": "string",
      "description": "Detailed implementation notes: what to build, constraints, considerations."
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "done", "failed", "blocked", "deferred"],
      "default": "pending"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-"
      },
      "description": "Task IDs that must be completed before this task can start."
    },
    "test": {
      "type": "object",
      "description": "Acceptance test for this specific task.",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "description": "Mendix user role used to test."
        },
        "steps": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Ordered test steps (open/click/fill/assert etc.)."
        },
        "expected": {
          "type": "string",
          "description": "Expected outcome."
        }
      }
    },
    "inspect": {
      "type": "object",
      "description": "Optional model inspection verification (mxcli-based).",
      "additionalProperties": false,
      "properties": {
        "microflow": {
          "type": "string",
          "description": "Fully qualified microflow name to inspect."
        },
        "expect": {
          "type": "string",
          "description": "Expected model structure or logic."
        }
      }
    },
    "repair": {
      "type": "object",
      "description": "Repair-specific fields. Only present when type=repair. Captures the full GAP Verification & Repair context per WP-14.",
      "additionalProperties": false,
      "properties": {
        "gap_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of the GAPs being repaired (e.g. GAP-ABTEILUNG-EXPAND)."
        },
        "gap_classifications": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["IMPLEMENTATION_GAP", "UI_PARITY_GAP", "INTERACTION_GAP", "ROLE_COVERAGE_GAP", "PLATFORM_BOUNDARY_VIOLATION", "REQUIREMENT_CHANGE", "DECISION_REQUIRED", "NOT_REPRODUCIBLE"]
          }
        },
        "source_feedback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" },
            "source": { "type": "string" },
            "observed_at": { "type": "string" },
            "observed_role": { "type": "string" },
            "observed_viewport": { "type": "string" },
            "evidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "target_reference": {
          "type": "object",
          "description": "Binding reference to the active target mockup used as the expected state for this repair.",
          "additionalProperties": false,
          "properties": {
            "mockup_id": { "type": "string" },
            "target_revision": { "type": "string" },
            "target_hash": { "type": ["string", "null"] },
            "requirements": { "type": "array", "items": { "type": "string" } },
            "decisions": { "type": "array", "items": { "type": "string" } },
            "screens": { "type": "array", "items": { "type": "string" } },
            "interactions": { "type": "array", "items": { "type": "string" } },
            "roles": { "type": "array", "items": { "type": "string" } }
          }
        },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "affected_mendix_artifacts": { "type": "array", "items": { "type": "string" } },
        "platform_constraints": { "type": "array", "items": { "type": "string" } },
        "implementation_status": {
          "type": "string",
          "enum": ["pending", "in_progress", "done"],
          "default": "pending"
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_checks": { "type": "array", "items": { "type": "string" } },
            "quality_gate": { "type": "string", "enum": ["pending", "pass", "fail"], "default": "pending" },
            "ui_parity": { "type": "string", "enum": ["pending", "pass", "fail"], "default": "pending" },
            "acceptance_journeys": { "type": "array", "items": { "type": "string" } },
            "regression_journeys": { "type": "array", "items": { "type": "string" } },
            "evidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "completion": {
          "type": "object",
          "description": "All fields must be true before setting task status to done.",
          "additionalProperties": false,
          "properties": {
            "original_gap_fixed": { "type": "boolean", "default": false },
            "no_new_consistency_errors": { "type": "boolean", "default": false },
            "affected_roles_verified": { "type": "boolean", "default": false },
            "interactions_verified": { "type": "boolean", "default": false },
            "critical_preservation_verified": { "type": "boolean", "default": false },
            "active_target_used": { "type": "boolean", "default": false },
            "artifacts_consistent": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "migrated_from": {
      "type": "string",
      "description": "Source file path for migrated tasks (e.g., planning/checklists/W01-implementation-checklist.yaml)."
    },
    "migration_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
