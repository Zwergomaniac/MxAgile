{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mxagile:delegation-result",
  "title": "MxAgile Delegation Result",
  "description": "Compact, resumable result from one completed bounded semantic delegation. Never contains a transcript, raw source, or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "delegation_id",
    "completed_at",
    "scope",
    "source_fingerprints",
    "conclusion",
    "findings",
    "provenance",
    "affected_ids",
    "unknowns",
    "conflicts",
    "decision_candidates",
    "evidence_references",
    "model_profile"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0", "1.1"] },
    "mission_id": { "type": "string", "minLength": 1 },
    "delegation_id": { "type": "string", "pattern": "^DELEGATION-[A-Za-z0-9._-]+$" },
    "agent_type": { "type": "string", "minLength": 1 },
    "completed_at": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "paths"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "identity": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "conclusion": { "type": "string", "minLength": 1 },
    "findings": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "array", "items": { "type": "string" } },
    "affected_ids": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "decision_candidates": { "type": "array", "items": { "type": "string" } },
    "evidence_references": { "type": "array", "items": { "type": "string" } },
    "model_profile": { "type": ["string", "null"], "enum": ["LIGHT", "MID", "HIGH", null] },
    "acceptance": {
      "type": "object",
      "description": "Mandatory deterministic acceptance of a control-plane child. Absent for legacy read-only results (NOT_REQUIRED).",
      "additionalProperties": false,
      "required": ["status", "gate_result", "finding_codes", "run_id", "handoff_reference", "verdict_reference"],
      "properties": {
        "status": { "type": "string", "enum": ["ACCEPTED", "PARTIAL", "REJECTED", "STALE", "NEEDS_HUMAN"] },
        "gate_result": { "type": ["string", "null"] },
        "finding_codes": { "type": "array", "items": { "type": "string" } },
        "run_id": { "type": ["string", "null"] },
        "handoff_reference": { "type": "string" },
        "verdict_reference": { "type": ["string", "null"] }
      }
    },
    "model_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_selection", "profile_resolution", "resolution", "resolved_model", "requested_reasoning_effort", "fallback_used", "fallback_reason"],
      "properties": {
        "model_selection": { "type": "string", "enum": ["supported", "unsupported", "unknown"] },
        "profile_resolution": { "type": "string", "enum": ["static_mapping", "dynamic_capability", "unknown", "unsupported"] },
        "resolution": { "type": "string", "enum": ["static_mapping", "dynamic_capability_request", "explicit_model_request", "fallback_available_model", "not_requested"] },
        "resolved_model": { "type": ["string", "null"] },
        "requested_reasoning_effort": { "type": ["string", "null"] },
        "fallback_used": { "type": "boolean" },
        "fallback_reason": { "type": ["string", "null"] },
        "escalation": {
          "type": "object", "additionalProperties": false,
          "required": ["main_profile", "main_model", "requested_child_profile", "resolved_child_profile", "requested_child_model", "spawn_request_model", "actual_model", "actual_model_status", "actual_model_source", "escalation_policy", "escalation_authority", "authority_reference", "decision", "reason"],
          "properties": {
            "main_profile": { "enum": ["LIGHT", "MID", "HIGH", null] },
            "main_model": { "type": ["string", "null"] },
            "requested_child_profile": { "enum": ["LIGHT", "MID", "HIGH", null] },
            "resolved_child_profile": { "enum": ["LIGHT", "MID", "HIGH", null] },
            "requested_child_model": { "type": ["string", "null"] },
            "spawn_request_model": { "type": ["string", "null"] },
            "actual_model": { "type": ["string", "null"] },
            "actual_model_status": { "enum": ["OBSERVED", "NOT_OBSERVABLE"] },
            "actual_model_source": { "type": ["string", "null"] },
            "escalation_policy": { "enum": ["never", "ask", "autonomous"] },
            "escalation_authority": { "enum": ["none", "main_profile_ceiling", "user_approval", "explicit_user_model", "autonomous_policy"] },
            "authority_reference": { "type": ["string", "null"] },
            "decision": { "enum": ["allowed", "limited", "needs_user_approval", "blocked"] },
            "reason": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            { "if": { "properties": { "actual_model_status": { "const": "NOT_OBSERVABLE" } } }, "then": { "properties": { "actual_model": { "type": "null" }, "actual_model_source": { "type": "null" } } } },
            { "if": { "properties": { "actual_model_status": { "const": "OBSERVED" } } }, "then": { "properties": { "actual_model": { "type": "string", "minLength": 1 }, "actual_model_source": { "type": "string", "minLength": 1 } } } }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "1.1" } } },
      "then": { "required": ["model_resolution", "agent_type"] }
    }
  ]
}