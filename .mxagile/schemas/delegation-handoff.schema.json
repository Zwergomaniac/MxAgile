{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mxagile:delegation-handoff",
  "title": "MxAgile Bounded Delegation Handoff",
  "description": "Task-scoped input to one subagent, bound to the parent's current delivery authorization. Conversation history, repository-wide context, secrets, and historical reports are not handoff fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "delivery_context",
    "delegation_id",
    "task",
    "agent_type",
    "scope",
    "authority_references",
    "artifact_paths",
    "source_fingerprints",
    "allowed_tools",
    "forbidden_mutations",
    "expected_result_schema",
    "model_profile",
    "model_resolution"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.3", "1.4"] },
    "mission_id": { "type": "string", "minLength": 1 },
    "delivery_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wave_id", "work_package_id", "project_root", "branch", "worktree", "base_head",
        "operating_mode", "authorization", "write_scope", "forbidden_scope", "required_artifacts",
        "verification_expectations", "commit_expectation", "resync_conditions", "required_skills",
        "loaded_skills", "required_capabilities", "available_capabilities", "required_evidence_sources",
        "evidence_destinations", "output_artifacts", "requested_model_profile", "resolved_model",
        "effective_model", "effective_model_status"
      ],
      "properties": {
        "wave_id": { "type": "string", "minLength": 1 },
        "work_package_id": { "type": "string", "minLength": 1 },
        "project_root": { "type": "string", "minLength": 1 },
        "branch": { "type": ["string", "null"] },
        "worktree": { "type": ["string", "null"] },
        "base_head": { "type": ["string", "null"], "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
        "operating_mode": {
          "type": "string",
          "enum": ["LIVE-SP-CURRENT", "CLOSED-AUTONOM", "LIVE-SP-OTHER", "AMBIGUOUS-SP-STATE", "UNKNOWN"]
        },
        "authorization": { "type": "string", "enum": ["read_only", "authorized_write"] },
        "write_scope": { "type": "array", "items": { "type": "string" } },
        "forbidden_scope": { "type": "array", "items": { "type": "string" } },
        "required_artifacts": { "type": "array", "items": { "type": "string" } },
        "verification_expectations": { "type": "array", "items": { "type": "string" } },
        "commit_expectation": { "type": "string", "enum": ["no_commit", "commit_authorized"] },
        "resync_conditions": { "type": "array", "items": { "type": "string" } },
        "required_skills": { "type": "array", "items": { "type": "string" } },
        "loaded_skills": { "type": "array", "items": { "type": "string" } },
        "required_capabilities": { "type": "array", "items": { "type": "string" } },
        "available_capabilities": { "type": "array", "items": { "type": "string" } },
        "required_evidence_sources": { "type": "array", "items": { "type": "string" } },
        "evidence_destinations": { "type": "array", "items": { "type": "string" } },
        "output_artifacts": { "type": "array", "items": { "type": "string" } },
        "requested_model_profile": { "type": ["string", "null"], "enum": ["LIGHT", "MID", "HIGH", null] },
        "resolved_model": { "type": ["string", "null"] },
        "effective_model": { "type": ["string", "null"] },
        "effective_model_status": { "type": "string", "enum": ["host_confirmed", "not_observable", "not_requested"] }
      }
    },
    "delegation_id": { "type": "string", "pattern": "^DELEGATION-[A-Za-z0-9._-]+$" },
    "task": { "type": "string", "minLength": 1 },
    "agent_type": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "paths"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authority_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference"],
        "properties": {
          "kind": { "type": "string" },
          "reference": { "type": "string" },
          "revision": { "type": ["string", "null"] }
        }
      }
    },
    "artifact_paths": { "type": "array", "items": { "type": "string" } },
    "source_fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "forbidden_mutations": { "type": "array", "items": { "type": "string" } },
    "expected_result_schema": { "type": "string", "const": "delegation-result/1.1" },
    "model_profile": { "type": ["string", "null"], "enum": ["LIGHT", "MID", "HIGH", null] },
    "model_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_selection", "profile_resolution", "resolution", "resolved_model", "requested_reasoning_effort", "fallback_used", "fallback_reason"],
      "properties": {
        "model_selection": { "type": "string", "enum": ["supported", "unsupported", "unknown"] },
        "profile_resolution": { "type": "string", "enum": ["static_mapping", "dynamic_capability", "unknown", "unsupported"] },
        "resolution": { "type": "string", "enum": ["static_mapping", "dynamic_capability_request", "fallback_available_model", "not_requested"] },
        "resolved_model": { "type": ["string", "null"] },
        "requested_reasoning_effort": { "type": ["string", "null"] },
        "fallback_used": { "type": "boolean" },
        "fallback_reason": { "type": ["string", "null"] }
      }
    },
    "context_budget_tokens": { "type": ["integer", "null"], "minimum": 1 },
    "result_budget_tokens": { "type": ["integer", "null"], "minimum": 1 },
    "run_id": { "type": "string", "pattern": "^RUN-[a-f0-9]{12}$", "description": "Ephemeral correlation ID for one child transition; not lifecycle state." },
    "parent_run_id": { "type": ["string", "null"], "pattern": "^RUN-[a-f0-9]{12}$" },
    "capability": { "type": "string", "minLength": 1 },
    "route_decision_reference": { "type": "string", "minLength": 1 },
    "write_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["IMPLEMENTATION_WRITE", "EVIDENCE_WRITE", "LIFECYCLE_WRITE", "DERIVED_PROJECTION_WRITE"] }
    },
    "evidence_destination": { "type": ["string", "null"] },
    "required_tools": { "type": "array", "items": { "type": "string" } },
    "input_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "identity", "path", "sha256"],
        "properties": {
          "kind": { "type": "string", "enum": ["mockup_revision", "requirement", "decision", "page", "lifecycle", "other"] },
          "identity": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "output_contract": { "type": "string", "minLength": 1 },
    "parent_observations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operating_mode": { "type": "string", "enum": ["LIVE-SP-CURRENT", "CLOSED-AUTONOM", "LIVE-SP-OTHER", "AMBIGUOUS-SP-STATE", "UNKNOWN"] },
        "project_identity_confirmed": { "type": "boolean" },
        "observed_at": { "type": "string" }
      }
    },
    "authorization_reference": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "1.4" } } },
      "then": { "required": ["run_id", "capability", "route_decision_reference", "write_classes", "evidence_destination", "required_tools", "input_sources", "output_contract"] }
    }
  ]
}