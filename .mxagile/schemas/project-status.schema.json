{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mxagile:project-status/2",
  "title": "MxAgile Project Status Projection 2",
  "description": "Deterministic, read-only projection of canonical MxAgile artifacts. Never a lifecycle authority. Missing or non-deterministic sources are represented as unavailable or null. No generated timestamp is included so identical inputs produce identical JSON.",
  "type": "object",
  "required": [
    "schema_version",
    "projection",
    "authority",
    "source_fingerprint",
    "project",
    "mission",
    "delivery",
    "requirements",
    "decisions",
    "verification",
    "findings",
    "runtime",
    "capabilities",
    "context",
    "sources",
    "gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "compatibility": {
      "type": "object",
      "required": ["schema_version", "read_only", "stage", "compatibility", "source_fingerprint", "repair_status", "coverage", "diagnostics"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "read_only": { "const": true },
        "stage": { "const": "PROJECT_COMPATIBILITY_CHECKED" },
        "compatibility": { "enum": ["COMPATIBLE", "PARTIAL", "BLOCKED"] },
        "source_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "repair_status": { "enum": ["PROJECT_REPAIR_REQUIRED", "DECISION_REQUIRED", null] },
        "coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["recognized", "parsed", "invalid", "unassigned"],
            "additionalProperties": false,
            "properties": {
              "recognized": { "type": "integer", "minimum": 0 },
              "parsed": { "type": "integer", "minimum": 0 },
              "invalid": { "type": "integer", "minimum": 0 },
              "unassigned": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["diagnostic_id", "severity", "category", "source_path", "line", "column", "artifact_type", "affected_board_area", "message", "repairability", "proposed_repair_type", "authority", "blocking"],
            "additionalProperties": false,
            "properties": {
              "diagnostic_id": { "type": "string", "pattern": "^DX-[0-9a-f]{16}$" },
              "severity": { "enum": ["INFO", "WARNING", "ERROR"] },
              "category": { "enum": ["SYNTAX_ERROR", "SCHEMA_ERROR", "ID_MISMATCH", "REFERENCE_MISSING", "REFERENCE_AMBIGUOUS", "WAVE_ASSIGNMENT_MISSING", "LEGACY_VARIANT", "UNSUPPORTED_VARIANT", "DUPLICATE_ID", "AUTHORITY_CONFLICT", "FRESHNESS_UNKNOWN", "MISSING", "UNASSIGNED", "STALE"] },
              "source_path": { "type": ["string", "null"] },
              "line": { "type": ["integer", "null"], "minimum": 1 },
              "column": { "type": ["integer", "null"], "minimum": 1 },
              "artifact_type": { "type": "string" },
              "affected_board_area": { "type": "string" },
              "message": { "type": "string" },
              "repairability": { "enum": ["SAFE_DETERMINISTIC", "AGENT_REPAIRABLE", "DECISION_REQUIRED", "UNSUPPORTED"] },
              "proposed_repair_type": { "enum": ["QUOTE_TEXT_SCALAR", "ADD_WAVE_ID", null] },
              "authority": { "type": ["string", "null"] },
              "blocking": { "type": "boolean" }
            }
          }
        }
      }
    },
    "schema_version": { "type": "integer", "const": 2 },
    "projection": { "type": "boolean", "const": true },
    "authority": { "type": "string", "const": "mxagile_canonical_artifacts" },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Deterministic hash of the canonical source files read by this projection."
    },
    "project": {
      "type": "object",
      "required": ["availability", "id", "name", "core_version", "active_targets", "lifecycle"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "core_version": { "type": ["string", "null"] },
        "active_targets": {
          "type": "object",
          "required": ["availability", "items"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "items": {
              "type": "array",
              "items": { "$ref": "#/definitions/active_target_reference" }
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "required": ["availability", "active_wave_id", "phase"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "active_wave_id": { "type": ["string", "null"] },
            "phase": { "$ref": "#/definitions/nullable_phase" }
          }
        }
      }
    },
    "mission": {
      "type": "object",
      "required": ["availability", "id", "status", "blocker_count", "blocker_types"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "id": { "type": ["string", "null"] },
        "status": {
          "type": ["string", "null"],
          "enum": ["active", "complete", "blocked", "archived", null]
        },
        "blocker_count": { "$ref": "#/definitions/nullable_count" },
        "blocker_types": {
          "type": "object",
          "required": ["INFRASTRUCTURE_GAP", "LOCATOR_UNSTABLE", "ROLE_SWITCH_BLOCKED", "DECISION_REQUIRED", "SCOPE_EXCEEDED", "OTHER"],
          "additionalProperties": false,
          "properties": {
            "INFRASTRUCTURE_GAP": { "$ref": "#/definitions/nullable_count" },
            "LOCATOR_UNSTABLE": { "$ref": "#/definitions/nullable_count" },
            "ROLE_SWITCH_BLOCKED": { "$ref": "#/definitions/nullable_count" },
            "DECISION_REQUIRED": { "$ref": "#/definitions/nullable_count" },
            "SCOPE_EXCEEDED": { "$ref": "#/definitions/nullable_count" },
            "OTHER": { "$ref": "#/definitions/nullable_count" }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["waves", "tasks", "task_progress", "checklist_progress", "workpackages"],
      "additionalProperties": false,
      "properties": {
        "waves": {
          "type": "object",
          "required": ["availability", "items", "phase_counts"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["wave_id", "phase", "gates", "task_progress", "checklist_progress", "requirement_ids", "task_ids"],
                "additionalProperties": false,
                "properties": {
                  "wave_id": { "type": "string" },
                  "phase": { "$ref": "#/definitions/nullable_phase" },
                  "gates": {
                    "type": "object",
                    "required": ["gate_to_refinement", "gate_to_ready"],
                    "additionalProperties": false,
                    "properties": {
                      "gate_to_refinement": { "$ref": "#/definitions/nullable_gate" },
                      "gate_to_ready": { "$ref": "#/definitions/nullable_gate" }
                    }
                  },
                  "task_progress": { "$ref": "#/definitions/progress_counts" },
                  "checklist_progress": {
                    "type": "object",
                    "required": ["availability", "total", "done", "source"],
                    "additionalProperties": false,
                    "properties": {
                      "availability": { "$ref": "#/definitions/availability" },
                      "total": { "$ref": "#/definitions/nullable_count" },
                      "done": { "$ref": "#/definitions/nullable_count" },
                      "source": { "type": ["string", "null"] }
                    }
                  },
                  "requirement_ids": { "type": "array", "items": { "type": "string" } },
                  "task_ids": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "phase_counts": {
              "type": "object",
              "required": ["discovery", "refinement", "ready", "implementing", "verifying", "done", "unknown"],
              "additionalProperties": false,
              "properties": {
                "discovery": { "$ref": "#/definitions/nullable_count" },
                "refinement": { "$ref": "#/definitions/nullable_count" },
                "ready": { "$ref": "#/definitions/nullable_count" },
                "implementing": { "$ref": "#/definitions/nullable_count" },
                "verifying": { "$ref": "#/definitions/nullable_count" },
                "done": { "$ref": "#/definitions/nullable_count" },
                "unknown": { "$ref": "#/definitions/nullable_count" }
              }
            }
          }
        },
        "task_progress": {
          "$ref": "#/definitions/progress_counts"
        },
        "tasks": {
          "type": "object",
          "required": ["availability", "items"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "action", "status", "wave_id", "workpackage_id", "requirement_ids", "migrated_from", "canonical_path", "content_hash"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string" },
                  "action": { "type": ["string", "null"] },
                  "status": { "type": ["string", "null"], "enum": ["pending", "in_progress", "done", "failed", "blocked", "deferred", null] },
                  "wave_id": { "type": ["string", "null"] },
                  "workpackage_id": { "type": ["string", "null"] },
                  "requirement_ids": { "type": "array", "items": { "type": "string" } },
                  "migrated_from": { "type": ["string", "null"] },
                  "canonical_path": { "type": "string" },
                  "content_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" }
                }
              }
            }
          }
        },
        "checklist_progress": {
          "type": "object",
          "required": ["availability", "total", "done", "source"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "total": { "$ref": "#/definitions/nullable_count" },
            "done": { "$ref": "#/definitions/nullable_count" },
            "source": { "type": ["string", "null"] }
          }
        },
        "workpackages": {
          "type": "object",
          "required": ["availability", "items", "unmapped_task_count"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "unmapped_task_count": { "$ref": "#/definitions/nullable_count" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["workpackage_id", "wave_id", "task_progress", "requirement_ids", "task_ids"],
                "additionalProperties": false,
                "properties": {
                  "workpackage_id": { "type": "string" },
                  "wave_id": { "type": ["string", "null"] },
                  "task_progress": { "$ref": "#/definitions/progress_counts" },
                  "requirement_ids": { "type": "array", "items": { "type": "string" } },
                  "task_ids": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": ["availability", "total", "status_counts", "items"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "total": { "$ref": "#/definitions/nullable_count" },
        "status_counts": {
          "type": "object",
          "required": ["draft", "accepted", "deferred", "superseded", "unknown"],
          "additionalProperties": false,
          "properties": {
            "draft": { "$ref": "#/definitions/nullable_count" },
            "accepted": { "$ref": "#/definitions/nullable_count" },
            "deferred": { "$ref": "#/definitions/nullable_count" },
            "superseded": { "$ref": "#/definitions/nullable_count" },
            "unknown": { "$ref": "#/definitions/nullable_count" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "status", "canonical_path", "content_hash"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"], "enum": ["draft", "accepted", "deferred", "superseded", null] },
              "canonical_path": { "type": "string" },
              "content_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "required": ["availability", "total", "status_counts", "pending_affected_requirements", "blocked_by_decision", "items"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "total": { "$ref": "#/definitions/nullable_count" },
        "status_counts": {
          "type": "object",
          "required": ["PROPOSED", "CONFIRMED", "REJECTED", "SUPERSEDED", "unknown"],
          "additionalProperties": false,
          "properties": {
            "PROPOSED": { "$ref": "#/definitions/nullable_count" },
            "CONFIRMED": { "$ref": "#/definitions/nullable_count" },
            "REJECTED": { "$ref": "#/definitions/nullable_count" },
            "SUPERSEDED": { "$ref": "#/definitions/nullable_count" },
            "unknown": { "$ref": "#/definitions/nullable_count" }
          }
        },
        "pending_affected_requirements": { "type": "array", "items": { "type": "string" } },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "status", "affected_requirements", "canonical_path", "content_hash"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"], "enum": ["PROPOSED", "CONFIRMED", "REJECTED", "SUPERSEDED", null] },
              "affected_requirements": { "type": "array", "items": { "type": "string" } },
              "canonical_path": { "type": "string" },
              "content_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" }
            }
          }
        },
        "blocked_by_decision": {
          "type": "object",
          "required": ["availability", "count"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "count": { "$ref": "#/definitions/nullable_count" }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["test_contracts", "proof_points", "plans", "evidence"],
      "additionalProperties": false,
      "properties": {
        "test_contracts": {
          "type": "object",
          "required": ["availability", "status_counts", "items"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "status_counts": {
              "type": "object",
              "required": ["draft", "active", "stale", "impacted", "superseded", "unknown"],
              "additionalProperties": false,
              "properties": {
                "draft": { "$ref": "#/definitions/nullable_count" },
                "active": { "$ref": "#/definitions/nullable_count" },
                "stale": { "$ref": "#/definitions/nullable_count" },
                "impacted": { "$ref": "#/definitions/nullable_count" },
                "superseded": { "$ref": "#/definitions/nullable_count" },
                "unknown": { "$ref": "#/definitions/nullable_count" }
              }
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "status", "requirement_ids", "proof_point_ids", "canonical_path", "content_hash"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": ["string", "null"] },
                  "status": { "type": ["string", "null"], "enum": ["draft", "active", "stale", "impacted", "superseded", null] },
                  "requirement_ids": { "type": "array", "items": { "type": "string" } },
                  "proof_point_ids": { "type": "array", "items": { "type": "string" } },
                  "canonical_path": { "type": "string" },
                  "content_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" }
                }
              }
            }
          }
        },
        "proof_points": {
          "type": "object",
          "required": ["availability", "status_counts"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "status_counts": {
              "type": "object",
              "required": ["active", "stale", "impacted", "deferred", "not_applicable", "unknown"],
              "additionalProperties": false,
              "properties": {
                "active": { "$ref": "#/definitions/nullable_count" },
                "stale": { "$ref": "#/definitions/nullable_count" },
                "impacted": { "$ref": "#/definitions/nullable_count" },
                "deferred": { "$ref": "#/definitions/nullable_count" },
                "not_applicable": { "$ref": "#/definitions/nullable_count" },
                "unknown": { "$ref": "#/definitions/nullable_count" }
              }
            }
          }
        },
        "plans": {
          "type": "object",
          "required": ["availability", "status_counts"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "status_counts": {
              "type": "object",
              "required": ["draft", "active", "superseded", "unknown"],
              "additionalProperties": false,
              "properties": {
                "draft": { "$ref": "#/definitions/nullable_count" },
                "active": { "$ref": "#/definitions/nullable_count" },
                "superseded": { "$ref": "#/definitions/nullable_count" },
                "unknown": { "$ref": "#/definitions/nullable_count" }
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": ["availability", "freshness", "target_freshness", "model_freshness", "recorded_counts", "current_counts", "entries"],
          "additionalProperties": false,
          "properties": {
            "availability": { "$ref": "#/definitions/availability" },
            "freshness": { "type": "string", "enum": ["determinable", "partial", "unknown"] },
            "target_freshness": { "type": "string", "enum": ["determinable", "partial", "unknown"] },
            "model_freshness": { "type": "string", "enum": ["determinable", "partial", "unknown"] },
            "recorded_counts": {
              "type": "object",
              "required": ["PASS", "FAIL", "PARTIAL", "NOT_VERIFIED", "STALE", "LEGACY_EVIDENCE", "unknown"],
              "additionalProperties": false,
              "properties": {
                "PASS": { "$ref": "#/definitions/nullable_count" },
                "FAIL": { "$ref": "#/definitions/nullable_count" },
                "PARTIAL": { "$ref": "#/definitions/nullable_count" },
                "NOT_VERIFIED": { "$ref": "#/definitions/nullable_count" },
                "STALE": { "$ref": "#/definitions/nullable_count" },
                "LEGACY_EVIDENCE": { "$ref": "#/definitions/nullable_count" },
                "unknown": { "$ref": "#/definitions/nullable_count" }
              }
            },
            "current_counts": {
              "type": "object",
              "required": ["verified", "unverified", "stale", "failed", "pending"],
              "additionalProperties": false,
              "properties": {
                "verified": { "$ref": "#/definitions/nullable_count" },
                "unverified": { "$ref": "#/definitions/nullable_count" },
                "stale": { "$ref": "#/definitions/nullable_count" },
                "failed": { "$ref": "#/definitions/nullable_count" },
                "pending": { "$ref": "#/definitions/nullable_count" }
              }
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["entry_id", "scenario_id", "screen_id", "parity_result", "requirement_ids", "wave_id", "mockup_name", "target_revision", "canonical_path"],
                "additionalProperties": false,
                "properties": {
                  "entry_id": { "type": "string" },
                  "scenario_id": { "type": "string" },
                  "screen_id": { "type": "string" },
                  "parity_result": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "PARTIAL", "NOT_VERIFIED", "STALE", "LEGACY_EVIDENCE", null] },
                  "requirement_ids": { "type": "array", "items": { "type": "string" } },
                  "wave_id": { "type": ["string", "null"] },
                  "mockup_name": { "type": ["string", "null"] },
                  "target_revision": { "type": ["string", "null"] },
                  "canonical_path": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "object",
      "required": ["availability", "open", "blocking", "closed", "unknown", "items"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "open": { "$ref": "#/definitions/nullable_count" },
        "blocking": { "$ref": "#/definitions/nullable_count" },
        "closed": { "$ref": "#/definitions/nullable_count" },
        "unknown": { "$ref": "#/definitions/nullable_count" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "gap_type", "severity", "lifecycle_status", "wave_id", "workpackage_id", "requirement_ids", "decision_ids", "evidence_refs", "blocking", "canonical_path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "gap_type": { "type": ["string", "null"] },
              "severity": { "type": ["string", "null"] },
              "lifecycle_status": { "type": ["string", "null"] },
              "wave_id": { "type": ["string", "null"] },
              "workpackage_id": { "type": ["string", "null"] },
              "requirement_ids": { "type": "array", "items": { "type": "string" } },
              "decision_ids": { "type": "array", "items": { "type": "string" } },
              "evidence_refs": { "type": "array", "items": { "type": "string" } },
              "blocking": { "type": "boolean" },
              "canonical_path": { "type": "string" }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["readiness_availability", "recorded_readiness", "operating_mode_availability", "operating_mode"],
      "additionalProperties": false,
      "properties": {
        "readiness_availability": { "$ref": "#/definitions/availability" },
        "recorded_readiness": {
          "type": "object",
          "required": ["runtime_config", "runtime_mode", "database", "mock_data", "test_identities", "runtime_pipeline_stage", "dependency_sync_state"],
          "additionalProperties": false,
          "properties": {
            "runtime_config": { "type": ["string", "null"], "enum": ["not_checked", "discovered", "incomplete", "user_input_required", "configured", "validation_failed", "ready", null] },
            "runtime_mode": { "type": ["string", "null"], "enum": ["interactive", "autonomous", "none", null] },
            "database": { "type": ["string", "null"], "enum": ["not_checked", "reachable", "unreachable", "auth_failed", "ready", null] },
            "mock_data": { "type": ["string", "null"], "enum": ["not_checked", "required", "seeded", "unavailable", null] },
            "test_identities": { "type": ["string", "null"], "enum": ["not_checked", "configured", "incomplete", "ready", null] },
            "runtime_pipeline_stage": { "type": ["string", "null"], "enum": ["not_started", "prerequisite_discovery", "dependency_sync", "build_in_progress", "build_succeeded", "runtime_started", "application_reachable", "browser_rendered", "authenticated_session_ready", "failed", null] },
            "dependency_sync_state": { "type": ["string", "null"], "enum": ["not_started", "active", "long_running", "stalled", "lock_contended", "completed", "failed", "unknown", null] }
          }
        },
        "operating_mode_availability": { "$ref": "#/definitions/availability" },
        "operating_mode": { "type": ["string", "null"], "enum": ["CLOSED-AUTONOM", "LIVE-SP-CURRENT", "LIVE-SP-OTHER", "AMBIGUOUS-SP-STATE", null] }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["availability", "active_count"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "active_count": { "$ref": "#/definitions/nullable_count" }
      }
    },
    "context": {
      "type": "object",
      "description": "Durable values come from the last canonical context-epoch checkpoint. mode and current session pressure are unavailable unless separately attested; pressure is the recorded checkpoint value, not a live measurement.",
      "required": ["availability", "epoch_id", "phase", "mode", "pressure"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "epoch_id": { "type": ["string", "null"] },
        "phase": { "$ref": "#/definitions/nullable_phase" },
        "mode": { "type": ["string", "null"] },
        "pressure": { "type": ["string", "null"], "enum": ["UNKNOWN", "NORMAL", "PRESSURE", "ROLLOVER_RECOMMENDED", "ROLLOVER_REQUIRED", null] }
      }
    },
    "sources": {
      "type": "object",
      "required": ["availability", "items"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "items": { "type": "array", "items": { "type": "object" } }
      }
    },
    "source_references": {
      "type": "object",
      "description": "Read-only deep-link inputs. canonical_path is repository-relative; clients construct local URLs and must never treat it as an arbitrary filesystem path.",
      "required": ["availability", "items"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/source_reference" } }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "source", "description"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "source": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "definitions": {
    "availability": {
      "type": "string",
      "enum": ["available", "partial", "unavailable", "ambiguous", "unknown"]
    },
    "active_target_reference": {
      "type": "object",
      "description": "A reference selected only by an accepted active revision or explicit UI-inventory target_mockup. It is not inferred from recency or filenames.",
      "required": ["availability", "reference_type", "mockup_name", "target_id", "revision_id", "authoritative_state", "canonical_path", "reference_root", "authority_sources", "source_fingerprint", "content_hash", "bundle_hash", "inventory_drift", "screen_ids", "section_ids"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "reference_type": { "type": "string", "enum": ["spa_bundle_entrypoint", "single_file_mockup", "unknown"] },
        "mockup_name": { "type": ["string", "null"] },
        "target_id": { "type": ["string", "null"] },
        "revision_id": { "type": ["string", "null"], "pattern": "^(REV-[0-9]{3,})?$" },
        "authoritative_state": { "type": "string", "enum": ["ACTIVE_TARGET", "UNKNOWN"] },
        "canonical_path": { "type": ["string", "null"] },
        "reference_root": { "type": ["string", "null"] },
        "authority_sources": { "type": "array", "items": { "$ref": "#/definitions/authority_source" } },
        "source_fingerprint": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "content_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "bundle_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "inventory_drift": {
          "type": "object",
          "required": ["state", "mismatched_screen_ids", "unknown_screen_ids"],
          "additionalProperties": false,
          "properties": {
            "state": { "type": "string", "enum": ["consistent", "mismatch", "unknown", "not_applicable"] },
            "mismatched_screen_ids": { "type": "array", "items": { "type": "string" } },
            "unknown_screen_ids": { "type": "array", "items": { "type": "string" } }
          }
        },
        "screen_ids": { "type": "array", "items": { "type": "string" } },
        "section_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authority_source": {
      "type": "object",
      "required": ["source_type", "canonical_path", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "source_type": { "type": "string", "enum": ["revision_manifest", "ui_inventory"] },
        "canonical_path": { "type": "string" },
        "content_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" }
      }
    },
    "source_reference": {
      "type": "object",
      "description": "A canonical artifact identity for local navigation; it is not a URL and grants no mutation authority.",
      "required": ["source_type", "canonical_path", "artifact_id", "anchor", "availability", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["wave_state", "requirement", "task", "checklist", "decision", "finding", "test_contract", "verification_plan", "evidence_manifest", "evidence_artifact", "parity_report"]
        },
        "canonical_path": { "type": "string" },
        "artifact_id": { "type": ["string", "null"] },
        "anchor": { "type": ["string", "null"] },
        "availability": { "$ref": "#/definitions/availability" },
        "content_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" }
      }
    },
    "nullable_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "progress_counts": {
      "type": "object",
      "required": ["availability", "total", "status_counts"],
      "additionalProperties": false,
      "properties": {
        "availability": { "$ref": "#/definitions/availability" },
        "total": { "$ref": "#/definitions/nullable_count" },
        "status_counts": {
          "type": "object",
          "required": ["pending", "in_progress", "done", "failed", "blocked", "deferred", "unknown"],
          "additionalProperties": false,
          "properties": {
            "pending": { "$ref": "#/definitions/nullable_count" },
            "in_progress": { "$ref": "#/definitions/nullable_count" },
            "done": { "$ref": "#/definitions/nullable_count" },
            "failed": { "$ref": "#/definitions/nullable_count" },
            "blocked": { "$ref": "#/definitions/nullable_count" },
            "deferred": { "$ref": "#/definitions/nullable_count" },
            "unknown": { "$ref": "#/definitions/nullable_count" }
          }
        }
      }
    },
    "nullable_phase": {
      "type": ["string", "null"],
      "enum": ["discovery", "refinement", "ready", "implementing", "verifying", "done", null]
    },
    "nullable_gate": {
      "type": ["string", "null"],
      "enum": ["not_recorded", "passed", "failed", null]
    }
  }
}