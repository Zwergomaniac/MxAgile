{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mxagile:finding/1",
  "title": "MxAgile Canonical Gap Finding",
  "description": "Durable, read-only-board-consumable GAP lifecycle record. Uses the existing GAP Verification & Repair lifecycle; observations are not requirements and a finding is not an authorization to mutate implementation.",
  "type": "object",
  "required": ["ID", "title", "gap_type", "severity", "lifecycle_status", "observation", "source_artifacts"],
  "additionalProperties": false,
  "properties": {
    "ID": { "type": "string", "pattern": "^FIND-[A-Z0-9][A-Z0-9_-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "gap_type": {
      "type": "string",
      "enum": ["VISUAL_GAP", "CONTENT_GAP", "INTERACTION_GAP", "STRUCTURE_GAP", "ROLE_GAP", "STATE_GAP", "SCOPE_GAP", "PLATFORM_BOUNDARY_GAP"]
    },
    "severity": { "type": "string", "enum": ["CRITICAL", "MATERIAL", "COSMETIC"] },
    "lifecycle_status": {
      "type": "string",
      "enum": ["DETECTED", "CLASSIFIED", "REPAIR_PROPOSED", "REPAIR_ACCEPTED", "REPAIRED", "VERIFIED", "REPAIR_REJECTED", "DECISION_REQUIRED", "SUPERSEDED", "RETIRED"]
    },
    "origin": { "type": "string", "enum": ["PROJECT", "FRAMEWORK_FOLLOWUP"], "default": "PROJECT" },
    "observation": { "type": "string", "minLength": 1 },
    "interpretation": { "type": "string" },
    "wave_id": { "type": "string", "pattern": "^W[A-Za-z0-9_-]+$" },
    "workpackage_id": { "type": "string", "minLength": 1 },
    "requirement_ids": { "type": "array", "items": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" } },
    "decision_ids": { "type": "array", "items": { "type": "string", "pattern": "^DEC-[0-9]{3,}$" } },
    "repair_task_id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_type", "canonical_path"],
        "additionalProperties": false,
        "properties": {
          "source_type": { "type": "string", "enum": ["requirement", "decision", "active_target", "parity_report", "ui_inventory", "other"] },
          "canonical_path": { "type": "string", "minLength": 1 },
          "artifact_id": { "type": "string" },
          "anchor": { "type": "string" }
        }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "resolution_references": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "superseded_by": { "type": "string", "pattern": "^FIND-[A-Z0-9][A-Z0-9_-]*$" },
    "retirement_reason": { "type": "string", "minLength": 1 },
    "framework_commit": { "$ref": "#/definitions/object_id" },
    "resolution_commit": { "$ref": "#/definitions/object_id" },
    "reconciliation": {
      "type": "object",
      "required": ["delta_fingerprint", "outcome", "assessed_at", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "delta_fingerprint": { "$ref": "#/definitions/fingerprint" },
        "outcome": { "type": "string", "enum": ["STILL_VALID", "RECLASSIFIED", "RESOLVED", "SUPERSEDED", "RETIRED"] },
        "assessed_at": { "type": "string", "format": "date-time" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "decision_ids": { "type": "array", "items": { "type": "string", "pattern": "^DEC-[0-9]{3,}$" }, "uniqueItems": true }
      }
    },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "authority_disposition": {
      "type": "object",
      "description": "Persisted authority decision consumed by later implementation. Its source/evidence fingerprint must still match the current project-status projection.",
      "required": ["status", "revision", "classification", "authoritative_sources", "allowed_action", "prohibited_actions", "unresolved_decision", "evidence_refs", "evidence_fingerprint", "reconciled_at"],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "RECONCILED" },
        "revision": { "type": "integer", "minimum": 1 },
        "classification": { "enum": ["CONFIRMED_IMPLEMENTATION_GAP", "REFERENCE_GAP", "AUTHORITY_CONFLICT", "VERIFICATION_OUTSTANDING", "INFORMATIONAL_COVERAGE_GAP"] },
        "authoritative_sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/disposition_authority_source" } },
        "allowed_action": { "enum": ["PROPOSE_IMPLEMENTATION", "REFERENCE_REFINEMENT", "DECISION_REQUIRED", "VERIFY", "NONE"] },
        "prohibited_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["APP_IMPLEMENTATION", "REFERENCE_CHANGE", "SEMANTIC_IMPLEMENTATION"] }
        },
        "unresolved_decision": { "type": ["string", "null"] },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/disposition_evidence_reference" } },
        "evidence_fingerprint": { "$ref": "#/definitions/fingerprint" },
        "reconciled_at": { "type": "string", "format": "date-time" }
      }
    },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  },
  "definitions": {
    "object_id": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "disposition_authority_source": {
      "type": "object",
      "required": ["source_type", "canonical_path", "artifact_id", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "source_type": { "enum": ["requirement", "decision", "active_target"] },
        "canonical_path": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/definitions/fingerprint" }
      }
    },
    "disposition_evidence_reference": {
      "type": "object",
      "required": ["source_type", "canonical_path", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "source_type": { "enum": ["parity_report", "evidence_manifest"] },
        "canonical_path": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/definitions/fingerprint" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycle_status": { "const": "SUPERSEDED" } }, "required": ["lifecycle_status"] },
      "then": { "required": ["superseded_by"] }
    },
    {
      "if": { "properties": { "lifecycle_status": { "const": "RETIRED" } }, "required": ["lifecycle_status"] },
      "then": { "required": ["retirement_reason"] }
    },
    {
      "if": {
        "properties": {
          "origin": { "const": "FRAMEWORK_FOLLOWUP" },
          "lifecycle_status": { "const": "VERIFIED" }
        },
        "required": ["origin", "lifecycle_status"]
      },
      "then": { "required": ["framework_commit", "resolution_commit", "resolution_references"] }
    }
    ,
    {
      "if": {
        "properties": {
          "origin": { "const": "FRAMEWORK_FOLLOWUP" },
          "lifecycle_status": { "const": "VERIFIED" }
        },
        "required": ["origin", "lifecycle_status"]
      },
      "then": {
        "required": ["evidence_refs", "reconciliation"],
        "properties": {
          "evidence_refs": { "type": "array", "minItems": 1 },
          "resolution_references": {
            "type": "array",
            "minItems": 1,
            "contains": { "type": "string", "pattern": "[Dd][Oo][Cc][Tt][Oo][Rr]" }
          },
          "reconciliation": {
            "properties": { "outcome": { "const": "RESOLVED" } },
            "required": ["outcome"]
          }
        }
      }
    },
    {
      "if": { "properties": { "authority_disposition": { "properties": { "classification": { "const": "CONFIRMED_IMPLEMENTATION_GAP" } }, "required": ["classification"] } }, "required": ["authority_disposition"] },
      "then": { "properties": { "authority_disposition": { "properties": { "allowed_action": { "const": "PROPOSE_IMPLEMENTATION" } }, "required": ["allowed_action"] } } }
    },
    {
      "if": { "properties": { "authority_disposition": { "properties": { "classification": { "const": "REFERENCE_GAP" } }, "required": ["classification"] } }, "required": ["authority_disposition"] },
      "then": { "properties": { "authority_disposition": { "properties": { "allowed_action": { "const": "REFERENCE_REFINEMENT" }, "prohibited_actions": { "contains": { "const": "APP_IMPLEMENTATION" } } }, "required": ["allowed_action", "prohibited_actions"] } } }
    },
    {
      "if": { "properties": { "authority_disposition": { "properties": { "classification": { "const": "AUTHORITY_CONFLICT" } }, "required": ["classification"] } }, "required": ["authority_disposition"] },
      "then": { "properties": { "authority_disposition": { "properties": { "allowed_action": { "const": "DECISION_REQUIRED" }, "prohibited_actions": { "contains": { "const": "SEMANTIC_IMPLEMENTATION" } }, "unresolved_decision": { "type": "string", "minLength": 1 } }, "required": ["allowed_action", "prohibited_actions", "unresolved_decision"] } } }
    },
    {
      "if": { "properties": { "authority_disposition": { "properties": { "classification": { "const": "VERIFICATION_OUTSTANDING" } }, "required": ["classification"] } }, "required": ["authority_disposition"] },
      "then": { "properties": { "authority_disposition": { "properties": { "allowed_action": { "const": "VERIFY" } }, "required": ["allowed_action"] } } }
    },
    {
      "if": { "properties": { "authority_disposition": { "properties": { "classification": { "const": "INFORMATIONAL_COVERAGE_GAP" } }, "required": ["classification"] } }, "required": ["authority_disposition"] },
      "then": { "properties": { "authority_disposition": { "properties": { "allowed_action": { "const": "NONE" } }, "required": ["allowed_action"] } } }
    },
    {
      "if": { "properties": { "reconciliation": { "properties": { "outcome": { "const": "RESOLVED" } }, "required": ["outcome"] } }, "required": ["reconciliation"] },
      "then": { "properties": { "lifecycle_status": { "const": "VERIFIED" } }, "required": ["lifecycle_status"] }
    },
    {
      "if": { "properties": { "reconciliation": { "properties": { "outcome": { "const": "SUPERSEDED" } }, "required": ["outcome"] } }, "required": ["reconciliation"] },
      "then": { "properties": { "lifecycle_status": { "const": "SUPERSEDED" } }, "required": ["lifecycle_status", "superseded_by"] }
    },
    {
      "if": { "properties": { "reconciliation": { "properties": { "outcome": { "const": "RETIRED" } }, "required": ["outcome"] } }, "required": ["reconciliation"] },
      "then": { "properties": { "lifecycle_status": { "const": "RETIRED" } }, "required": ["lifecycle_status", "retirement_reason"] }
    }
  ]
}